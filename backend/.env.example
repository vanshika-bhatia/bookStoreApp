# MongoDB Database Connection String
MONGODB_URI="mongodb://127.0.0.1:27017/bookhaven"

# JWT Secret Key
JWT_SECRET=""

# Optional: Google Books API Key
GOOGLE_BOOKS_API_KEY=""

# This API's public origin (OAuth callback host)
AUTH_URL="http://localhost:3001"
APP_URL="http://localhost:3001"

# Browser origin of the Next.js frontend (CORS + OAuth redirects)
FRONTEND_ORIGIN="http://localhost:3000"

# Optional extra CORS origins, comma-separated
FRONTEND_ORIGINS=""

# Cookie flags for split origins on different sites (not needed for localhost ports)
# COOKIE_SAMESITE="none"
# COOKIE_SECURE="true"

# Auth.js (NextAuth) secret — used to sign OAuth sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google OAuth credentials (Auth.js)
# Authorized redirect URI used by the UI: http://localhost:3001/api/auth/social/google/callback
# (Auth.js also supports http://localhost:3001/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Gmail SMTP (use a Google App Password, not your Gmail account password)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
